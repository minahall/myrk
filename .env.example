# ============================================================================
# LOCAL DEV — copy these 6 lines into .env.local and fill them in.
# One `npm run dev` process acts as every relay, so everything goes in one file.
# ============================================================================

# ---- From Supabase dashboard → Project Settings → API ----
NEXT_PUBLIC_SUPABASE_URL=
# Labeled "Publishable key" in the new dashboard (starts with sb_publishable_).
# Safe to expose to the browser — RLS is what protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Labeled "Secret key" in the new dashboard (starts with sb_secret_).
# NEVER ship to the browser. Only Node C reads this.
SUPABASE_SERVICE_ROLE_KEY=

# ---- From /admin/keys in your browser ----
# Click "Copy private JWK" for each node. Each is a one-line JSON string.
NODE_A_PRIVATE_KEY=
NODE_B_PRIVATE_KEY=
NODE_C_PRIVATE_KEY=


# ============================================================================
# PRODUCTION ONLY — see DEPLOY.md for the four-project split.
# Each production deployment sets NODE_ROLE so middleware.ts hides the API
# routes that don't belong to that deployment.
# ============================================================================
# Frontend project (NODE_ROLE=frontend):
#   NEXT_PUBLIC_NODE_A_URL=https://myrk-node-a.vercel.app/api/node-a
#
# Node A project (NODE_ROLE=a):
#   NODE_B_URL=https://myrk-node-b.vercel.app/api/node-b
#   ALLOWED_ORIGIN=https://myrk.vercel.app
#   SEND_LIMIT_PER_MIN=10
#
# Node B project (NODE_ROLE=b):
#   NODE_C_URL=https://myrk-node-c.vercel.app/api/node-c
#
# Node C project (NODE_ROLE=c): already set above (needs SUPABASE_SERVICE_ROLE_KEY)
